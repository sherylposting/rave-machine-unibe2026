#include <Wire.h>
#include <I2C_MPU6886.h>
#include <Arduino.h>

// this is just the basic code to get the sensor displaying on the serial monitor

I2C_MPU6886 imu;

float accX, accY, accZ;
float gyroX, gyroY, gyroZ;
float temp;

char buffer[128];

void setup() {
  Serial.begin(115200);
  delay(2000);

  Serial.println("Starting I2C...");
  Wire.begin(26, 32);   // M5 Atom Lite Grove Port

  Serial.println("Init MPU6886...");
  imu.begin();

  Serial.println("MPU6886 Init OK");

  const char* imu_csv = "acc_x, acc_y, acc_z, gyro_x, gyro_y, gyro_z\n";

}

void loop() {
  imu.getAccel(&accX, &accY, &accZ);
  imu.getGyro(&gyroX, &gyroY, &gyroZ);
  imu.getTemp(&temp);

  sprintf(buffer, "%.2f, %.2f, %.2f, %.2f, %.2f, %.2f", accX, accY, accZ, gyroX, gyroY, gyroZ);
  Serial.print(buffer);

  delay(300);
}